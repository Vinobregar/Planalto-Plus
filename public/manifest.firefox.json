{
  "manifest_version": 3,
  "name": "Planalto Plus — Leitura Jurídica & IA",
  "short_name": "Planalto Plus",
  "version": "1.0.8",
  "description": "Moderniza o Planalto.gov.br com leitura limpa, sumário hierárquico, texto compilado, grifos, flashcards Anki e assistente de IA.",
  "browser_specific_settings": {
    "gecko": {
      "id": "planalto-plus@antigravity.br",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "*://*.planalto.gov.br/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://openrouter.ai/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Planalto Plus — Configurações & IA",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.planalto.gov.br/ccivil_03/*",
        "*://*.planalto.gov.br/*lei*",
        "*://*.planalto.gov.br/*decreto*",
        "*://*.planalto.gov.br/*constituicao*"
      ],
      "exclude_matches": [
        "*://*.planalto.gov.br/ccivil_03/constituicao/emendas/ecr/quadro_ecr.htm*",
        "*://*.planalto.gov.br/ccivil_03/constituicao/emendas/emc/quadro_emc.htm*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "sql-wasm.wasm"
      ],
      "matches": [
        "*://*.planalto.gov.br/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ]
    }
  ]
}
